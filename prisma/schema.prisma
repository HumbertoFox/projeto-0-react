generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cpf {
  cpf         String   @id @unique @db.VarChar(11)
  name        String   @db.VarChar(100)
  dateofbirth DateTime @db.Date
  email       String   @db.VarChar(150)
  telephone   String   @db.VarChar(11)
  cpfUser     User[]

  @@map("Cpfs")
}

model Zipcode {
  zipcode        String    @id @unique @db.VarChar(11)
  street         String    @db.VarChar(100)
  district       String    @db.VarChar(100)
  city           String    @db.VarChar(100)
  zipcodeAddress Address[]

  @@map("Zipcodes")
}

model Address {
  address_id      Int      @id @unique @default(autoincrement())
  residencenumber String   @db.VarChar(50)
  building        String   @db.VarChar(100)
  buildingblock   String   @db.VarChar(50)
  apartment       String   @db.VarChar(50)
  registerdate    DateTime @default(now()) @db.Timestamp(0)
  zipcode         String   @db.VarChar(11)
  addressZipcode  Zipcode  @relation(fields: [zipcode], references: [zipcode])
  user            User[]

  @@map("Addresss")
}

model Donation {
  donation_id     Int      @unique @default(autoincrement())
  user_id         Int
  registerdate    DateTime @default(now()) @db.Timestamp(0)
  donarionUser_id User     @relation(fields: [user_id], references: [user_id])

  @@map("Donations")
}

model User {
  user_id        Int        @id @unique @default(autoincrement())
  cpf            String     @db.VarChar(11)
  address_id     Int        @db.Integer
  userCpf        Cpf        @relation(fields: [cpf], references: [cpf])
  userAddress_id Address    @relation(fields: [address_id], references: [address_id])
  userDonation   Donation[]

  @@map("Users")
}